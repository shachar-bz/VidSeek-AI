{
  "name": "vidseek-promo-video",
  "private": true,
  "version": "1.0.0",
  "description": "VidSeek AI promo ad built with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts VidSeekPromo out/vidseek-promo-v2.mp4 --crf 14 --image-format png --x264-preset veryfast",
    "still": "remotion still src/index.ts VidSeekPromo out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/media-utils": "4.0.529",
    "@remotion/renderer": "^4.0.529",
    "@remotion/transitions": "4.0.529",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
