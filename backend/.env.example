# Copy to backend/.env and fill in. Every value is read through backend/core/config.py,
# which prefers the process environment over this file, so any of these can be overridden
# in CI or in a test without editing your local copy.
#
# Nothing here is required to start the service. Each key is only needed by the feature
# that uses it, and is reported at the point of use if it is missing.

# Speech transcription through ElevenLabs Scribe. Used by the transcription service, and
# by both download pipelines when no captions exist for a video.
ELEVENLABS_API_KEY_TRANSCRIPT=

# ElevenLabs forced alignment, kept as its own key apart from ELEVENLABS_API_KEY_TRANSCRIPT
# above so alignment traffic is never billed or rate-limited against the transcription
# key's own quota. Used by the web download pipeline as a fallback: when a video's
# transcript text is already known but was never timed, this times it against the video's
# audio instead of transcribing the video from scratch. English only — anything else falls
# back to ELEVENLABS_API_KEY_TRANSCRIPT transcription.
ELEVENLABS_API_KEY_FORCED_ALIGNMENT=

# OpenAI, used by two stages: transcription through gpt-transcribe in the OpenAI pipeline,
# and dividing a finished transcript into semantic memories through gpt-6.1-sol.
OPENAI_API_KEY_DUDU=

# YouTube Data API v3, used to fetch a video's top comments. A YouTube download still
# succeeds without it; the job simply reports no comments.
YOUTUBE_API_KEY=

# Comma-separated Chrome extension ids allowed to open a companion session. The companion
# refuses every session request until at least one is listed.
VIDSEEK_EXTENSION_IDS=

# Comma-separated website origins allowed to call the authenticated API and to sign up or
# log in, for example https://app.vidseek.ai,https://staging.vidseek.ai. When this is blank
# and VIDSEEK_REQUIRE_LOOPBACK is true, the frontend's fixed local development origins
# (http://localhost:5173 and http://127.0.0.1:5173) are allowed automatically. Hosted
# deployments must list each origin explicitly: wildcard origins are rejected so
# bearer-authenticated requests are never exposed to every website.
VIDSEEK_WEBSITE_ORIGINS=

# Restrict every request to a loopback client. This defaults to true when omitted, which
# protects the local companion. Set it to false only for a hosted API behind its network
# boundary or reverse proxy.
VIDSEEK_REQUIRE_LOOPBACK=true

# Where downloads and transcripts are written. Defaults to ~/Downloads/VidSeek.
VIDSEEK_DOWNLOAD_ROOT=

# Index every stored video for what it shows (SigLIP 2 frame vectors and content-change
# segments), in the background after the upload. On by default; it wants a CUDA GPU, so turn
# it off on a machine without one and its videos are marked `skipped`. Needs ffmpeg on PATH
# and downloads google/siglip2-base-patch16-256 to the Hugging Face cache on first use.
VIDSEEK_VISUAL_INDEXING=true

# Load the text embedding model (and SigLIP 2, when visual indexing is on) in the background
# as soon as the API starts, so the first question after a restart does not wait about 10 to
# 12 seconds for them. On by default; turn it off to hold the models in memory only once they
# are first used.
VIDSEEK_PRELOAD_MODELS=true

# Read the on-screen text of every keyframe (slides, boards, code) with Surya OCR, in Hebrew
# and English, after the visual index is stored. Surya cannot share this backend's Python
# environment (it needs torch >= 2.7 and Pillow < 11), so it runs in a worker process started
# with the interpreter of an environment of its own. Leave empty to turn OCR off; videos are
# still indexed visually and their keyframes are left unread. To set it up:
#   python -m venv C:\vidseek-ocr
#   C:\vidseek-ocr\Scripts\pip install -r backend/services/ocr/surya/requirements.txt
# and point this at C:\vidseek-ocr\Scripts\python.exe.
VIDSEEK_OCR_PYTHON=

# Surya runs its OCR model under llama.cpp's `llama-server`: download a CUDA build from
# https://github.com/ggml-org/llama.cpp/releases (the model itself is fetched from Hugging Face
# on first use). Leave empty when llama-server is on PATH.
VIDSEEK_OCR_LLAMA_SERVER=

# --- Azure Blob Storage ---
# Where downloaded video files are stored so they outlive the machine that downloaded
# them. This is not optional: the local copy a job makes exists only to get the video
# transcribed and is deleted once the upload succeeds, so a job with no storage account
# configured fails at its last step rather than quietly keeping the file here.

# The whole credential, copied from the storage account's Access keys page in the Azure
# portal. It carries the account name, the account key and the endpoint together, which is
# why there is nothing else to set: the account name and key are read back out of it to
# sign a download link.
AZURE_STORAGE_CONNECTION_STRING=

# The container the videos are written into. It must already exist; nothing here creates
# it. Blobs are named videos/<job id>/<filename> inside it.
AZURE_STORAGE_CONTAINER_NAME=videos


# --- Azure Database for PostgreSQL ---
# Everything about a video that is not its bytes: the row describing it, its transcript
# segments and its comments. Unlike Blob Storage this one is optional -- a job whose video
# uploaded but could not be recorded still finishes, and reports that it was stored but not
# recorded -- so a checkout with no database still downloads and transcribes.

# The connection URL for the Flexible Server, in the shape
# postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<database>?sslmode=require
# Percent-encode any of : / ? # [ ] @ in the password. sslmode=require is not optional:
# Azure refuses unencrypted connections. ASURE_DATABASE_URL is read as well, so an existing
# .env carrying that misspelling keeps working.
AZURE_DATABASE_URL=

# Before the backend can write anything, apply the schema once from the repository root:
#
#   python -m backend.storage.postgres.migrate
#
# It applies every file in backend/storage/postgres/migrations/ that this database has not
# had applied yet, records each in schema_migrations, and is safe to run again. The first
# migration enables pgvector, which on Azure fails until `vector` is added to the
# `azure.extensions` server parameter (the server > Settings > Server parameters); the
# runner says so if that is what went wrong. The server's firewall also has to allow this
# machine's public IP, since the backend runs locally and is not an Azure service.
#
# pgvector is the only extension needed. gen_random_uuid(), which every table's primary key
# defaults to, has been in the server core since PostgreSQL 13, so pgcrypto -- which Azure
# does not allow-list by default -- is never asked for.

# Optional field mapping for unknown player/caption JSON. Uses OPENAI_API_KEY_DUDU.
# Signed URLs, cookies, and speech text are kept out of model input.
VIDSEEK_DISCOVERY_LLM=true
VIDSEEK_DISCOVERY_MODEL=gpt-6.1-sol
