# Copy to backend/.env and fill in. Every value is read through backend/core/config.py,
# which prefers the process environment over this file, so any of these can be overridden
# in CI or in a test without editing your local copy.
#
# Nothing here is required to start the service. Each key is only needed by the feature
# that uses it, and is reported at the point of use if it is missing.

# Speech transcription through ElevenLabs Scribe. Used by the transcription service, and
# by both download pipelines when no captions exist for a video.
ELEVENLABS_API_KEY=

# Transcription through OpenAI's gpt-transcribe, used by the OpenAI pipeline only.
OPENAI_API_KEY_DUDU=

# Public page transcript extraction, used by the web download pipeline before it falls
# back to transcribing the audio.
FIRECRAWL_API_KEY=

# YouTube Data API v3, used to fetch a video's top comments. A YouTube download still
# succeeds without it; the job simply reports no comments.
YOUTUBE_API_KEY=

# Comma-separated Chrome extension ids allowed to open a companion session. The companion
# refuses every session request until at least one is listed.
VIDSEEK_EXTENSION_IDS=

# Where downloads and transcripts are written. Defaults to ~/Downloads/VidSeek.
VIDSEEK_DOWNLOAD_ROOT=

# --- Cloudflare R2 object storage ---
# Where downloaded video files are stored so they outlive the machine that downloaded
# them. R2 speaks the S3 API, so these are the four values an S3 client needs. Create an
# R2 API token in the Cloudflare dashboard (R2 > Manage API tokens) with Object Read &
# Write on the bucket below.

# The token's "Access Key ID".
R2_ACCESS_KEY_ID=

# The token's "Secret Access Key". R2_SECRET_ACCESS_KEY is read as well, so Cloudflare's
# own snippet can be pasted unchanged.
R2_ACCESS_KEY=

# The account endpoint, https://<account id>.r2.cloudflarestorage.com, without the bucket
# appended: the bucket is added by the client and belongs in R2_BUCKET_NAME.
R2_ENDPOINT_URL=

# The bucket the videos are written into. It must already exist; nothing here creates it.
R2_BUCKET_NAME=


# --- Supabase ---
# The Postgres side of storage: what describes a video, next to the R2 key that holds its
# file. Apply backend/storage/supabase/migrations/*.sql to the project once before the
# backend can write anything.

# The project URL, https://<project ref>.supabase.co, with no path on it.
SUPABASE_URL=

# The service role key, or a secret key (Dashboard > Project Settings > API Keys). This is
# the key the backend should use: it bypasses row level security, which the tables rely on
# to stay closed to everyone else. Treat it like a database password and never ship it to
# a browser.
SUPABASE_SERVICE_ROLE_KEY=

# The anon key, or a publishable key, used as a fallback when no service role key is set.
# It is the key meant for client-side code and is governed entirely by row level security,
# so with the policies in the migration it can read and write nothing.
SUPABASE_ANON_KEY=

# A Supabase personal access token (Dashboard > Account > Access Tokens), needed only to
# apply the migrations. No code in the backend reads this: every key above reaches the
# project through PostgREST, which acts on rows and has no CREATE TABLE, so schema changes
# go through the Management API or the dashboard's SQL editor instead. It is an
# account-level credential rather than an application one — scope it to this project with
# Database > Write and nothing else, and revoke it once the schema is where you want it.
SUPABASE_ACCESS_TOKEN=


